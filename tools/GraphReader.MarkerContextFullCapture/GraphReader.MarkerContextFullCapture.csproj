<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>GraphReader.RealAcceptance.Ocr</AssemblyName>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../GraphReader.RealAcceptance.Ocr/FrozenCandidateBinding.cs" Link="FrozenCandidateBinding.cs" />
    <Compile Include="../GraphReader.RealAcceptance.Ocr/NoPersistenceStageCache.cs" Link="NoPersistenceStageCache.cs" />
    <Compile Include="../GraphReader.MarkerBoundInputTrainCapture/CenterBinding.cs" Link="CenterBinding.cs" />
    <Compile Include="../GraphReader.MarkerBoundInputTrainCapture/CandidateInterfaces.cs" Link="CandidateInterfaces.cs" />
    <Compile Include="../GraphReader.MarkerDualViewTrainCapture/SamplerCapture.cs" Link="SamplerCapture.cs" />
    <Compile Include="../GraphReader.MarkerDualViewTrainCapture/PanelProvenance.cs" Link="PanelProvenance.cs" />
    <Compile Include="../Shared/ComposedOcrExecutionIdentity.cs" Link="ComposedOcrExecutionIdentity.cs" />
    <!-- Compile only against the exact authenticated managed runtime used by the parent capture. -->
    <Reference Include="../../artifacts/goal22-runs/marker-context-bound-input-runtime-v1/*.dll" />
  </ItemGroup>
</Project>
