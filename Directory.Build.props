<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>0.4.35</Version>
    <AssemblyVersion>0.4.35.0</AssemblyVersion>
    <FileVersion>0.4.35.0</FileVersion>
    <InformationalVersion>0.4.35</InformationalVersion>
    <Authors>Sungwoo Kang</Authors>
    <Copyright>Copyright 2026 Sungwoo Kang</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/SKang393/GraphAutoReader</RepositoryUrl>
  </PropertyGroup>
</Project>
