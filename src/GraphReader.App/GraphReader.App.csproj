<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Resources\Identity\GraphAutoReader.ico</ApplicationIcon>
    <GraphReaderRuntimeMode Condition="'$(GraphReaderRuntimeMode)' == ''">ManualPreview</GraphReaderRuntimeMode>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GraphReader.App.Tests" />
    <InternalsVisibleTo Include="GraphReader.SyntheticRuntimeEvidence" />
    <AssemblyMetadata Include="GraphReaderRuntimeMode" Value="$(GraphReaderRuntimeMode)" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Fonts\NotoSans-Regular.ttf" />
    <Resource Include="Assets\Fonts\NotoSans-Medium.ttf" />
    <Resource Include="Assets\Fonts\NotoSans-SemiBold.ttf" />
  </ItemGroup>

  <Target Name="ValidateGraphReaderRuntimeMode" BeforeTargets="CoreCompile">
    <Error
      Condition="'$(GraphReaderRuntimeMode)' != 'ManualPreview' and '$(GraphReaderRuntimeMode)' != 'Production'"
      Text="GraphReaderRuntimeMode must be ManualPreview or Production." />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\GraphReader.Domain\GraphReader.Domain.csproj" />
    <ProjectReference Include="..\GraphReader.Imaging\GraphReader.Imaging.csproj" />
    <ProjectReference Include="..\GraphReader.Pdf\GraphReader.Pdf.csproj" />
    <ProjectReference Include="..\GraphReader.Axis\GraphReader.Axis.csproj" />
    <ProjectReference Include="..\GraphReader.Ocr\GraphReader.Ocr.csproj" />
    <ProjectReference Include="..\GraphReader.Markers\GraphReader.Markers.csproj" />
    <ProjectReference Include="..\GraphReader.Legends\GraphReader.Legends.csproj" />
    <ProjectReference Include="..\GraphReader.Phases\GraphReader.Phases.csproj" />
    <ProjectReference Include="..\GraphReader.Export\GraphReader.Export.csproj" />
    <ProjectReference Include="..\GraphReader.Inference\GraphReader.Inference.csproj" />
    <ProjectReference Include="..\GraphReader.SuperResolution\GraphReader.SuperResolution.csproj" />
  </ItemGroup>
</Project>
